# Vorlage für .env – kopieren und anpassen:
#   cp .env.example .env
#
# Geheimnisse erzeugen:
#   openssl rand -hex 32

# ---------- Pflicht ----------

# Passwort des Datenbankbenutzers.
POSTGRES_PASSWORD=bitte-aendern

# Schlüssel für die Sitzungs-Token. Wird er geändert, sind alle Anmeldungen
# ungültig. Niemals ins Repository aufnehmen.
JWT_SECRET=bitte-mit-openssl-rand-hex-32-erzeugen

# ---------- Startkonto ----------
# Nur beim allerersten Start ausgewertet: Existiert das Konto bereits, bleibt
# das gesetzte Passwort unangetastet.
# Startkonto (optional, seit 1.5.1)
#
# Normalerweise leer lassen: Beim ersten Öffnen im Browser legt man das
# Admin-Konto selbst an. Ein Passwort in dieser Datei bliebe sonst dort
# stehen - im Klartext, in jeder Sicherung, und meist unveraendert.
#
# Nur fuer automatisierte Aufbauten ohne Menschen am Browser ausfuellen:
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=bitte-aendern-2026
ADMIN_NAME=Administrator

# ---------- Optional ----------

POSTGRES_USER=klappe
POSTGRES_DB=klappe

# Port, unter dem die Oberfläche auf dem Host erreichbar ist.
WEB_PORT=3000

# Öffentliche Adresse. Sie steht in jeder E-Mail und in jedem Freigabe-Link,
# muss also von außen stimmen – hinter HTTPS entsprechend https://…
PUBLIC_URL=http://localhost:3000

# Cookie nur über HTTPS senden. Ohne Angabe richtet sich das nach PUBLIC_URL:
# https:// → an, http:// → aus. Von Hand auf 1 zu setzen, während PUBLIC_URL
# auf http:// zeigt, macht die Anmeldung unmöglich – der Browser wirft das
# Cookie dann weg, ohne etwas zu melden.
# SESSION_COOKIE_SECURE=1
SESSION_COOKIE_NAME=klappe_session
SESSION_TTL_SECONDS=604800

# Wohin die Nutzdaten kommen: Originale, Proxys, Poster, Sprites und die
# Teildateien laufender Uploads. Ohne Angabe ein benanntes Docker-Volume – das
# ist nur für einen Probelauf gedacht. Im Betrieb hierhin einen echten Pfad
# setzen, sonst landen 40-GB-Kamerabänder unter /var/lib/docker, das auf
# Unraid und Synology ein Abbild fester Größe ist, an dem alle anderen
# Container mit hängen.
#MEDIA_DIR=/mnt/user/klappe/media

# Wie lange der Web-Dienst eine ruhende Verbindung offen hält, in Millisekunden.
# Nodes Standard von 5 Sekunden ist zu kurz: Safari hält die Verbindung dann
# noch für benutzbar, schreibt den nächsten Upload-Block hinein, und der
# verschwindet spurlos. Nicht unter 59000 setzen (siehe docker-compose.yml).
#KEEP_ALIVE_TIMEOUT=59000

# Größte erlaubte Einzeldatei (Standard 200 GB).
UPLOAD_MAX_BYTES=214748364800

# Nur zur Fehlersuche: Schreibt jeden Upload-Block mit – wann er eintrifft, wo
# er stehen bleibt, wann er fertig ist. Beantwortet die Frage, ob ein hängender
# Upload die API überhaupt erreicht. Ein 40-GB-Upload erzeugt damit zehntausend
# Zeilen, deshalb im Normalbetrieb aus.
#UPLOAD_TRACE=1

# ---------- Anmeldung ----------
# Microsoft 365 wird in der Oberfläche eingerichtet (Einstellungen →
# Anmeldung), nicht hier. Diese Angabe braucht nur, wer nicht die weltweite
# Entra-Cloud benutzt (US Government, China).
#OIDC_AUTHORITY=https://login.microsoftonline.com

# ---------- HTTPS ----------
# Zwei Wege, beide ohne Zertifikatsgefummel – siehe README, Abschnitt HTTPS.
#
# 1. Cloudflared-Tunnel: nichts hier eintragen, keinen Port aufmachen. Der
#    Tunnel wird bei Cloudflare eingerichtet und zeigt auf http://web:3000.
# 2. Eigene Domain mit Portfreigabe 80/443: die beiden Werte setzen und mit
#    `-f docker-compose.https.yml` starten; Caddy holt das Zertifikat selbst.
#KLAPPE_DOMAIN=klappe.example.org
#ACME_EMAIL=technik@example.org

# ---------- Transcoding ----------

# Gleichzeitige Transcodings.
WORKER_CONCURRENCY=1

# Womit der Worker kodiert. Standard ist die Software-Kodierung libx264, die
# überall läuft. h264_videotoolbox nutzt den Hardware-Encoder von Apple
# Silicon – das gilt nur für einen nativ auf macOS laufenden Worker, denn im
# Container gibt es kein VideoToolbox. Das x264-Preset (PROXY_PRESET bzw.
# Einstellungen → Transcode) ist dann ohne Wirkung; die Bitraten gelten
# weiter. Einrichtung: docs/apple-silicon.md.
#VIDEO_ENCODER=libx264

# Pfade zu ffmpeg und ffprobe, falls sie nicht im Suchpfad stehen. Im
# Container sind sie es; der native Worker auf dem Mac nimmt die
# Homebrew-Programme.
#FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
#FFPROBE_PATH=/opt/homebrew/bin/ffprobe

# Ab Phase 19 stehen die folgenden vier Werte auch unter
# **Einstellungen → Transcode**. Was dort einmal gespeichert wurde, gilt –
# diese Zeilen sind dann nur noch die Voreinstellung für eine frische Anlage.
# Betroffen: PROXY_SHORT_EDGE, PROXY_VIDEO_BITRATE, PROXY_PRESET und
# HLS_ENABLED. Ein Neustart ist für eine Änderung in der Oberfläche nicht
# nötig; der Worker liest sie vor jedem Auftrag frisch.

# Zielgröße der **kurzen** Kante der Abspielfassung. Bei Hochformat und
# quadratischem Material ist die Höhe das falsche Maß: 1080 heißt hier
# 1920×1080 im Querformat und 1080×1920 im Hochformat.
PROXY_SHORT_EDGE=1080

# Passendes Material wird gar nicht erst neu kodiert (H.264/AAC, yuv420p,
# MP4/MOV, kurze Kante klein genug). Oberhalb dieser Bitrate lohnt sich das
# Neukodieren trotzdem, weil das Abspielen sonst hakt.
PLAYBACK_MAX_BITRATE_BPS=20000000

PROXY_VIDEO_BITRATE=10M
# x264-Voreinstellung: veryfast, faster, fast, medium … langsamer = kleiner.
PROXY_PRESET=veryfast

# ---------- Adaptive Wiedergabe (optional) ----------
# Zusätzlich zur Abspielfassung eine HLS-Stufenleiter erzeugen (2160p/1080p/
# 720p/480p, je nach Quelle). Kostet einen weiteren Durchlauf pro Datei und
# ist deshalb aus. Lohnt sich, wenn Kunden über schwache Leitungen zusehen.
# Seit Phase 19 auch als Schalter unter Einstellungen → Transcode; sie läuft
# dann als Nacharbeit, wahlweise erst in einem Zeitfenster.
HLS_ENABLED=0
HLS_SEGMENT_SECONDS=4
