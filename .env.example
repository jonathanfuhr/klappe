# Vorlage für .env – kopieren und anpassen:
#   cp .env.example .env
#
# Geheimnisse erzeugen:
#   openssl rand -hex 32

# ---------- Pflicht ----------

# Passwort des Datenbankbenutzers.
POSTGRES_PASSWORD=bitte-aendern

# Schlüssel für die Sitzungs-Token. Wird er geändert, sind alle Anmeldungen
# ungültig. Niemals ins Repository aufnehmen.
JWT_SECRET=bitte-mit-openssl-rand-hex-32-erzeugen

# ---------- Startkonto ----------
# Nur beim allerersten Start ausgewertet: Existiert das Konto bereits, bleibt
# das gesetzte Passwort unangetastet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=bitte-aendern-2026
ADMIN_NAME=Administrator

# ---------- Optional ----------

POSTGRES_USER=klappe
POSTGRES_DB=klappe

# Port, unter dem die Oberfläche auf dem Host erreichbar ist.
WEB_PORT=3000

# Öffentliche Adresse. Sie steht in jeder E-Mail und in jedem Freigabe-Link,
# muss also von außen stimmen – hinter HTTPS entsprechend https://…
PUBLIC_URL=http://localhost:3000

# Cookie nur über HTTPS senden. Für einen lokalen Test ohne TLS auf 0 setzen.
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_NAME=klappe_session
SESSION_TTL_SECONDS=604800

# Größte erlaubte Einzeldatei (Standard 200 GB).
UPLOAD_MAX_BYTES=214748364800

# ---------- HTTPS ----------
# Zwei Wege, beide ohne Zertifikatsgefummel – siehe README, Abschnitt HTTPS.
#
# 1. Cloudflared-Tunnel: nichts hier eintragen, keinen Port aufmachen. Der
#    Tunnel wird bei Cloudflare eingerichtet und zeigt auf http://web:3000.
# 2. Eigene Domain mit Portfreigabe 80/443: die beiden Werte setzen und mit
#    `-f docker-compose.https.yml` starten; Caddy holt das Zertifikat selbst.
#KLAPPE_DOMAIN=klappe.example.org
#ACME_EMAIL=technik@example.org

# ---------- Transcoding ----------

# Gleichzeitige Transcodings.
WORKER_CONCURRENCY=1

# Zielgröße der **kurzen** Kante der Abspielfassung. Bei Hochformat und
# quadratischem Material ist die Höhe das falsche Maß: 1080 heißt hier
# 1920×1080 im Querformat und 1080×1920 im Hochformat.
PROXY_SHORT_EDGE=1080

# Passendes Material wird gar nicht erst neu kodiert (H.264/AAC, yuv420p,
# MP4/MOV, kurze Kante klein genug). Oberhalb dieser Bitrate lohnt sich das
# Neukodieren trotzdem, weil das Abspielen sonst hakt.
PLAYBACK_MAX_BITRATE_BPS=20000000

PROXY_VIDEO_BITRATE=10M
# x264-Voreinstellung: veryfast, faster, fast, medium … langsamer = kleiner.
PROXY_PRESET=veryfast
