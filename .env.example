# Vorlage für .env – kopieren und anpassen:
#   cp .env.example .env
#
# Geheimnisse erzeugen:
#   openssl rand -hex 32

# ---------- Pflicht ----------

# Passwort des Datenbankbenutzers.
POSTGRES_PASSWORD=bitte-aendern

# Schlüssel für die Sitzungs-Token. Wird er geändert, sind alle Anmeldungen
# ungültig. Niemals ins Repository aufnehmen.
JWT_SECRET=bitte-mit-openssl-rand-hex-32-erzeugen

# ---------- Startkonto ----------
# Nur beim allerersten Start ausgewertet: Existiert das Konto bereits, bleibt
# das gesetzte Passwort unangetastet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=bitte-aendern-2026
ADMIN_NAME=Administrator

# ---------- Optional ----------

POSTGRES_USER=klappe
POSTGRES_DB=klappe

# Port, unter dem die Oberfläche auf dem Host erreichbar ist.
WEB_PORT=3000

# Öffentliche Adresse (für Links in späteren E-Mails).
PUBLIC_URL=http://localhost:3000

# Cookie nur über HTTPS senden. Für einen lokalen Test ohne TLS auf 0 setzen.
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_NAME=klappe_session
SESSION_TTL_SECONDS=604800

# Größte erlaubte Einzeldatei (Standard 200 GB).
UPLOAD_MAX_BYTES=214748364800

# ---------- Transcoding ----------

# Gleichzeitige Transcodings.
WORKER_CONCURRENCY=1
# Zielhöhe und Bitrate des Playback-Proxys.
PROXY_HEIGHT=1080
PROXY_VIDEO_BITRATE=10M
# x264-Voreinstellung: veryfast, faster, fast, medium … langsamer = kleiner.
PROXY_PRESET=veryfast
