# Zugangsdaten für die DNS-Nachführung (klappe-ddns.sh).
#
# Kopieren, ausfüllen, abdichten:
#
#   mkdir -p ~/.config/klappe-ddns
#   cp deploy/mac/klappe-ddns.env.beispiel ~/.config/klappe-ddns/env
#   chmod 600 ~/.config/klappe-ddns/env
#
# Das Skript weigert sich zu laufen, solange die Datei weiter als 600 offen
# steht – ein Token, das jeder lesen darf, ist keines mehr.

# --------------------------------------------------------------- Das API-Token
#
# **Hier hinein kommt der Wert aus dem Cloudflare-Dashboard.**
#
#   dash.cloudflare.com → Profilbild rechts oben → Mein Profil
#   → API-Tokens → Token erstellen
#   → Vorlage „Zonen-DNS bearbeiten" verwenden
#   → Zonenressourcen: Einschließen · Bestimmte Zone · <deine Zone>
#   → Client-IP-Filter LEER lassen (die eigene IP ist ja genau das, was
#     wechselt – ein Filter darauf sperrt das Token beim nächsten Reconnect aus)
#   → Gültigkeit ohne Ablaufdatum (läuft es ab, hört die Nachführung
#     stillschweigend auf)
#
# Der Token wird genau einmal angezeigt. Er braucht nichts weiter als
# `Zone → DNS → Bearbeiten`; der globale API-Schlüssel gehört hier nicht hinein.
CF_API_TOKEN=hier-das-token-einfuegen

# Die Zone, so wie sie bei Cloudflare heißt – ohne Unterdomäne.
CF_ZONE=beispiel.de

# Die Namen, die auf den Anschluss zeigen sollen. Voll ausgeschrieben,
# mehrere durch Leerzeichen (Komma geht auch).
#
# Hinter dem Reverse Proxy steht mehr als eine Anwendung, und alle hängen am
# selben Anschluss — sie brauchen also dieselbe Adresse. Ein zweiter
# Zeitplan mit einem zweiten Skript wäre dieselbe Arbeit doppelt.
CF_RECORD="medien.beispiel.de werkzeug.beispiel.de"

# Kurz halten: Nach einem Reconnect soll die alte Adresse schnell aus den
# Zwischenspeichern verschwinden. 60 Sekunden ist bei Cloudflare das Minimum.
CF_TTL=60
